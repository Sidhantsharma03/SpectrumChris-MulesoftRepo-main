	<flow name="servicereferral-scheduler-flow" doc:id="8bb9d76d-76e7-4b96-a842-f71ecc4466a9" >
		<http:listener doc:name="Listener" doc:id="9d06720b-1535-4977-af5f-7041b085322b" config-ref="HTTP_Listener_config" path="/serviceReferralTrigger"/>
		<logger level="INFO" doc:name="flowStartLog" doc:id="c6688750-422b-4d81-9c63-9af238098be9" message='"Start of ServiceReferral Flow"'/>
		<ee:transform doc:name="getMessageList-refferalAccept-request" doc:id="abfc443c-6ad5-4d4d-8c91-dafb245925f9" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var messageTypes = ["ServiceReferral", "ServiceFrequencyUpdate"]
---
{ 
  ContractVersion: "OnePointZero",
  RequestItems: messageTypes map (mt) -> {
    RequestFilter: {
      //EndDate: "2025-05-26",
     // StartDate: "2024-05-21",
     MessageStatus: "Posted",
     MessageType: mt,
     ExpectedResponseVersion: "99.0"
    }
  }
}]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="username" ><![CDATA[p('secure::username')
]]></ee:set-variable>
				<ee:set-variable variableName="password" ><![CDATA[p('secure::password')
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<dotnet:execute doc:name="getMessageList-referral-execute" doc:id="0fc66b51-d94e-4d7a-965a-efa3bbaf7e2d" config-ref="Microsoft_DotNet_Config" type="ProvincialXML_HP.ProvinicalXML, ProvincialXML_HP, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" method="ProvincialXML_HP.ProvinicalXML, ProvincialXML_HP, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null | GetMessage(ProvincialXML_HP.ProvincialXmlService.GetMessageListRequestItemWrapper req, System.String username, System.String password) -&gt; ProvincialXML_HP.ProvincialXmlService.GetMessageListResponseItemWrapper">
			<dotnet:arguments ><![CDATA[#[{
	req: payload,
	username: p('secure::username'),
	password: p('secure::password')
}]]]></dotnet:arguments>
		</dotnet:execute>
		<set-payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;read(payload, "application/json").responseItems map {&#10;  responseData: $.responseData,&#10;  messageDestination: $.responseFilter.messageDestination&#10;}]' doc:name="pullReferralResponseDataList" doc:id="32c4a6e1-5a58-4973-b606-962bdab7f2a8" />
		<set-variable value='#["Total number of referral record": sizeOf(payload)]' doc:name="Payload Size" doc:id="2086d882-d47e-4843-9dc2-a7f88c10c066" variableName="sizeOfPayload"/>
		<logger level="INFO" doc:name="sizeOfPayload" doc:id="a933e0b4-aff1-4ff0-a094-b1a00092384e" message='#[vars.sizeOfPayload]'/>
		<foreach doc:name="For Each" doc:id="23e85b9b-9557-4d11-a8b2-9208f7551c00" collection="#[payload]">
			<ee:transform doc:name="getMessage-processReferral-request" doc:id="f43a2009-89ec-4b65-a727-a1eab7a03b5d">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	ContractVersion: "OnePointZero",
	RequestItems: 
    [{
    RequestData: payload.responseData,
    RequestSenderType: "Team",
    RequestSenderId: payload.messageDestination,
    ExpectedResponseVersion: "99.0"
	}]
}]]></ee:set-payload>
			</ee:message>
				<ee:variables >
					<ee:set-variable variableName="extractTeamID" ><![CDATA[payload.messageDestination]]></ee:set-variable>
				</ee:variables>
		
</ee:transform>
			<dotnet:execute type="ProvincialXML_HP.ProvinicalXML, ProvincialXML_HP, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" doc:name="getMessage-referral-execute" doc:id="99a636ef-38c4-4b41-a669-3847996e8870" method="ProvincialXML_HP.ProvinicalXML, ProvincialXML_HP, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null | GetMessage(ProvincialXML_HP.ProvincialXmlService.GetMessageRequestItemWrapper req, System.String username, System.String password) -&gt; ProvincialXML_HP.ProvincialXmlService.GetMessageResponseItemWrapper" config-ref="Microsoft_DotNet_Config">
			<dotnet:arguments><![CDATA[#[{
	req: payload,
	username: p('secure::username'),
	password: p('secure::password')
}]]]></dotnet:arguments>
		</dotnet:execute>
			<logger level="INFO" doc:name="Before Data Parsing" doc:id="28e7522c-5545-4c75-a949-feb46102cd5e" message="Before Data Parsing: #[payload]" />
			<ee:transform doc:name="pxmlExtract" doc:id="56d3ac25-b424-4a2f-9494-27ab695040f8">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/xml indent=true

var parsedJson = read(payload, "application/json")
var rawXml = parsedJson.responseItems[0].responseData
var cleanedXml = rawXml
    replace "\\n" with "" 
    replace "\\r" with "" 
    replace "\\t" with "" 
    replace "\\\"" with "\"" 
    replace "\\'" with "'"

---
read(cleanedXml, "application/xml")
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
			<logger level="INFO" doc:name="logger" doc:id="67463611-4f48-4042-9d6c-0546d99ca820" message="Salesforce call with Json payload:  #[payload]" />
			<until-successful maxRetries="${http.max.retries.attempt}" doc:name="Until Successful" doc:id="1563be82-3c56-4cf9-a2b4-082d370b0b8f" millisBetweenRetries="${http.max.retries.count}">
				<http:request method="POST" doc:name="sapiReferralEndpoint-Call" doc:id="84db8aa2-a143-4399-b1fb-3bd4bca2186e" url="${sapi.referral.url}">
				<http:query-params><![CDATA[#[output application/java
---
{
	teamID : vars.extractTeamID
}]]]></http:query-params>
					<http:response-validator >
						<http:success-status-code-validator values="200,201,400, 404, 500" />
					</http:response-validator>
			</http:request>
			<ee:transform doc:name="Check System API Response">
    <ee:variables>

        <!-- True if System API returned 4xx or 5xx -->
        <ee:set-variable variableName="isSystemApiError"><![CDATA[
            (payload.statusCode default 200) > 299
        ]]></ee:set-variable>

        <!-- Store full response for logging or Salesforce log -->
        <ee:set-variable variableName="systemApiError"><![CDATA[payload
        ]]></ee:set-variable>

    </ee:variables>
</ee:transform>
			</until-successful>
			<choice doc:name="">
            <when expression='#[vars.systemApiError.sourceSystem == "SAPI (Salesforce System API)"]'>
                <raise-error type="APP:SAPI_ERROR_RESPONSE" doc:name="Raise Error" description="CUSTOMERROR" />
            </when>
            <otherwise>
                <!-- Do nothing → means success -->
						<logger level="DEBUG" message=" SAPI response OK." />

            
</otherwise>
        </choice>
			<logger level="INFO" doc:name="Salesforce Response" doc:id="9698ac0d-a405-45a2-af14-130ff5528de7" message="Salesforce Response: #[payload]"/>

		</foreach>
		<ee:transform doc:name="Transform Message" doc:id="c7edc844-e682-443e-b7d4-2395238fb604">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"payload": payload,
	"received referral PXML data": vars.sizeOfPayload
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
		<logger level="INFO" doc:name="flowEndLog" doc:id="e5711229-0db5-4377-9782-62c0b3fee0d2" message="#[payload]"/>
		<error-handler ref="global-error-handler" />
	</flow>
